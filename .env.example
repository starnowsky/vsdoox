# Порт, на котором работает сервис
PORT=5000

# Путь к БД (SQLite по умолчанию; для PostgreSQL — postgresql+psycopg://user:pass@host/dbname)
VSDOOX_DB_URL=sqlite:////data/vsdoox.db

# Ключ администратора (необязательно; если задан — создаётся при первом старте)
VSDOOX_ADMIN_KEY=

# Gunicorn (production WSGI)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
